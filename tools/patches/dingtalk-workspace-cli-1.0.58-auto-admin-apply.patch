+func (p *DeviceFlowProvider) requestCLIAuthApproval(
+	ctx context.Context,
+	oauthProvider *OAuthProvider,
+	accessToken string,
+	admins *SuperAdminResponse,
+	adminErr error,
+) error {
+	if adminErr != nil {
+		return fmt.Errorf("get organization super administrators: %w", adminErr)
+	}
+	if admins == nil || !admins.Success || len(admins.Result) == 0 {
+		message := "no organization super administrator is available"
+		if admins != nil && strings.TrimSpace(admins.ErrorMsg) != "" {
+			message = strings.TrimSpace(admins.ErrorMsg)
+		}
+		return errors.New(message)
+	}
+
+	admin := admins.Result[0]
+	apply, err := deviceSendApply(ctx, accessToken, admin.StaffID)
+	if err != nil {
+		return fmt.Errorf("send CLI data access request: %w", err)
+	}
+	if apply == nil || !apply.Success || !apply.Result {
+		message := "DingTalk rejected the CLI data access request"
+		if apply != nil && strings.TrimSpace(apply.ErrorMsg) != "" {
+			message = strings.TrimSpace(apply.ErrorMsg)
+		}
+		return errors.New(message)
+	}
+
+	_, _ = fmt.Fprintf(p.output(), "\n✅ 已向主管理员 %s 发送 CLI 数据访问申请。\n", admin.Name)
+	_, _ = fmt.Fprintln(p.output(), localMindApprovalMarker)
+	_, _ = fmt.Fprintln(p.output(), "⏳ 正在等待主管理员审批...")
+
+	approvalTimeout := time.NewTimer(deviceApprovalTimeout)
+	defer approvalTimeout.Stop()
+	pollTicker := time.NewTicker(deviceApprovalPollInterval)
+	defer pollTicker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-approvalTimeout.C:
+			return errors.New("timed out waiting for DingTalk administrator approval")
+		case <-pollTicker.C:
+			status, err := deviceCheckCLIAuth(oauthProvider, ctx, accessToken)
+			if err != nil {
+				continue
+			}
+			reason := classifyDenialReason(status, os.Getenv("DWS_CHANNEL"))
+			if reason == "" {
+				_, _ = fmt.Fprintln(p.output(), "✅ 主管理员已批准 CLI 数据访问申请。")
+				return nil
+			}
+			if reason != "cli_not_enabled" && reason != "unknown" {
+				return fmt.Errorf("DingTalk administrator approval did not grant CLI access: %s", reason)
+			}
+		}
+	}
+}
