@@ -0,0 +1,99 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"log/slog"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLocalMindDeviceFlowAutoAppliesForCLIAuth(t *testing.T) {
+	oldRequest := deviceRequestCode
+	oldWait := deviceWaitAuth
+	oldExchange := deviceExchangeCode
+	oldCheck := deviceCheckCLIAuth
+	oldAdmins := deviceGetAdmins
+	oldApply := deviceSendApply
+	oldPollInterval := deviceApprovalPollInterval
+	oldApprovalTimeout := deviceApprovalTimeout
+	oldSaveToken := deviceSaveToken
+	oldHasApp := deviceHasAppConfig
+	t.Cleanup(func() {
+		deviceRequestCode = oldRequest
+		deviceWaitAuth = oldWait
+		deviceExchangeCode = oldExchange
+		deviceCheckCLIAuth = oldCheck
+		deviceGetAdmins = oldAdmins
+		deviceSendApply = oldApply
+		deviceApprovalPollInterval = oldPollInterval
+		deviceApprovalTimeout = oldApprovalTimeout
+		deviceSaveToken = oldSaveToken
+		deviceHasAppConfig = oldHasApp
+	})
+	t.Setenv(localMindAutoApplyEnv, "1")
+
+	deviceRequestCode = func(*DeviceFlowProvider, context.Context) (*DeviceAuthResponse, error) {
+		return &DeviceAuthResponse{UserCode: "CODE", Interval: 1, ExpiresIn: 600}, nil
+	}
+	deviceWaitAuth = func(*DeviceFlowProvider, context.Context, *DeviceAuthResponse) (*DeviceTokenResponse, error) {
+		return &DeviceTokenResponse{AuthCode: "auth-code"}, nil
+	}
+	deviceExchangeCode = func(*OAuthProvider, context.Context, string) (*TokenData, error) {
+		return &TokenData{AccessToken: "access-token"}, nil
+	}
+	checks := 0
+	deviceCheckCLIAuth = func(*OAuthProvider, context.Context, string) (*CLIAuthStatus, error) {
+		checks++
+		return &CLIAuthStatus{
+			Success: true,
+			Result:  &CLIAuthResult{CLIAuthEnabled: checks > 1},
+		}, nil
+	}
+	deviceGetAdmins = func(context.Context, string) (*SuperAdminResponse, error) {
+		return &SuperAdminResponse{
+			Success: true,
+			Result: []SuperAdmin{
+				{StaffID: "admin-1", Name: "Primary Admin"},
+				{StaffID: "admin-2", Name: "Other Admin"},
+			},
+		}, nil
+	}
+	requestedAdmin := ""
+	deviceSendApply = func(_ context.Context, _ string, adminStaffID string) (*SendApplyResponse, error) {
+		requestedAdmin = adminStaffID
+		return &SendApplyResponse{Success: true, Result: true}, nil
+	}
+	deviceApprovalPollInterval = time.Millisecond
+	deviceApprovalTimeout = time.Second
+	tokenSaved := false
+	deviceSaveToken = func(string, *TokenData) error {
+		tokenSaved = true
+		return nil
+	}
+	deviceHasAppConfig = func(string) bool { return true }
+
+	var output bytes.Buffer
+	p := &DeviceFlowProvider{
+		configDir: t.TempDir(),
+		clientID:  "client-id",
+		Output:    &output,
+		logger:    slog.New(slog.NewTextHandler(io.Discard, nil)),
+		NoBrowser: true,
+	}
+	token, err := p.loginOnce(context.Background(), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if token == nil || !tokenSaved {
+		t.Fatal("device token was not saved after administrator approval")
+	}
+	if requestedAdmin != "admin-1" {
+		t.Fatalf("approval requested from %q, want first administrator", requestedAdmin)
+	}
+	if !strings.Contains(output.String(), localMindApprovalMarker) {
+		t.Fatalf("approval marker missing from output: %s", output.String())
+	}
+}
