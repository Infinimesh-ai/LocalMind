# LocalMind base URL. Use HTTPS and set AFFINE_SERVER_HTTPS=true behind TLS.
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3011
AFFINE_SERVER_HTTPS=false
BIND_ADDRESS=0.0.0.0
PORT=3011

# PostgreSQL. Replace DB_PASSWORD before the first production deployment.
DB_USERNAME=affine
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT
DB_DATABASE=affine

# Persistent data paths, relative to .docker/selfhost by default.
UPLOAD_LOCATION=./data/localmind/storage
CONFIG_LOCATION=./data/localmind/config
DB_DATA_LOCATION=./data/localmind/postgres/pgdata
ENTERPRISE_CLI_DATA_LOCATION=./data/localmind/enterprise-cli

# Fixed LocalMind runtime image role.
LOCALMIND_AFFINE_IMAGE=localmind-affine:local

# Optional enterprise connectors. Credentials are configured after deployment.
LOCALMIND_ENTERPRISE_CLI_ENABLED=false

# Optional embedding and rerank upstreams used by the bundled adapter.
SPARKCLAW_EMBEDDING_ORIGIN=https://sparkclaw.infinimesh.cloud/embedding
SPARKCLAW_RERANK_ORIGIN=https://sparkclaw.infinimesh.cloud/reranker

# Optional server-controlled SparkClaw MCP endpoint.
# LOCALMIND_SPARKCLAW_MCP_ENDPOINT=https://sparkclaw.example.com/mcp

# Optional proactive SparkClaw notifications. Enable these together with the
# Compose "iscp" profile. The controller rejects missing, short, or non-TLS
# values when the profile starts.
ISCP_ENABLED=false
# ISCP_CONTROLLER_TOKEN=replace-with-at-least-32-random-characters
# ISCP_DOMAIN_ID=localmind
# ISCP_RELAY_ID=localmind-relay
# ISCP_RELAY_PUBLIC_BASE_URL=https://localmind.example.com/iscp
# ISCP_RELAY_PUBLIC_WS_URL=wss://localmind.example.com/iscp/v2/relay/connect
# ISCP_ALLOWED_ORIGINS=https://localmind.example.com
# ISCP_CONTROLLER_PORT=8091
# ISCP_RELAY_PORT=8080
