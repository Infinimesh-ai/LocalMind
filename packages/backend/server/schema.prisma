generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["metrics", "relationJoins", "nativeDistinct", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  workspaceFiles WorkspaceFile[]

  officeComments       OfficeComment[]
  officeCommentReplies OfficeCommentReply[]

  id              String    @id @default(uuid()) @db.VarChar
  name            String    @db.VarChar
  email           String    @unique @db.VarChar
  emailVerifiedAt DateTime? @map("email_verified") @db.Timestamptz(3)
  avatarUrl       String?   @map("avatar_url") @db.VarChar
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Not available if user signed up through OAuth providers
  password        String?   @db.VarChar
  /// Indicate whether the user finished the signup progress.
  /// for example, the value will be false if user never registered and invited into a workspace by others.
  registered      Boolean   @default(true)
  disabled        Boolean   @default(false)

  features                                  UserFeature[]
  userStripeCustomer                        UserStripeCustomer?
  workspaceMembers                          WorkspaceMember[]
  workspaceInvitations                      WorkspaceInvitation[]                  @relation("workspace_invitation_invitee")
  createdWorkspaceInvitations               WorkspaceInvitation[]                  @relation("workspace_invitation_inviter")
  // Invite others to join the workspace
  connectedAccounts                         ConnectedAccount[]
  calendarAccounts                          CalendarAccount[]
  mcpResourceOperations                     McpResourceOperation[]
  mcpCredentials                            McpCredential[]
  aiMcpAttachments                          AiMcpAttachment[]                      @relation("mcp_attachment_actor")
  mcpDelegationEndpoints                    AiMcpDelegationEndpoint[]              @relation("mcp_delegation_endpoint_user")
  aiMcpDelegationRequests                   AiMcpDelegationRequest[]               @relation("mcp_delegation_request_actor")
  createdExternalMcpConnections             AiExternalMcpConnection[]              @relation("external_mcp_connection_creator")
  externalMcpAuditEvents                    AiExternalMcpAuditEvent[]              @relation("external_mcp_audit_actor")
  externalMcpToolExecutions                 AiExternalMcpToolExecution[]           @relation("external_mcp_tool_execution_actor")
  enterpriseConnections                     AiEnterpriseConnection[]               @relation("enterprise_connection_user")
  enterpriseAuditEvents                     AiEnterpriseAuditEvent[]               @relation("enterprise_audit_actor")
  enterpriseAuthorizationSessions           AiEnterpriseAuthorizationSession[]     @relation("enterprise_authorization_user")
  sessions                                  UserSession[]
  aiSessions                                AiSession[]
  appConfigs                                AppConfig[]
  userSnapshots                             UserSnapshot[]
  createdSnapshot                           Snapshot[]                             @relation("createdSnapshot")
  updatedSnapshot                           Snapshot[]                             @relation("updatedSnapshot")
  createdUpdate                             Update[]                               @relation("createdUpdate")
  createdHistory                            SnapshotHistory[]                      @relation("createdHistory")
  createdAiJobs                             AiJobs[]                               @relation("createdAiJobs")
  // receive notifications
  notifications                             Notification[]                         @relation("user_notifications")
  notificationRefresh                       NotificationRefresh?
  iscpAgentEndpoints                        IscpAgentEndpoint[]
  iscpEnrollments                           IscpEnrollment[]
  settings                                  UserSettings?
  comments                                  Comment[]
  replies                                   Reply[]
  commentAttachments                        CommentAttachment[]                    @relation("createdCommentAttachments")
  workspaceCalendars                        WorkspaceCalendar[]
  workspaceMemberLastAccesses               WorkspaceMemberLastAccess[]
  quotaState                                EffectiveUserQuotaState?
  ownedQuotaStates                          EffectiveWorkspaceQuotaState[]
  aiSupportBundleRequests                   AiSupportBundleRequest[]               @relation("support_bundle_request_actor")
  aiSupportBundleAuditEvents                AiSupportBundleAuditEvent[]            @relation("support_bundle_audit_event_actor")
  aiSupportBundleDownloadAuthorizations     AiSupportBundleDownloadAuthorization[] @relation("support_bundle_download_authorization_actor")
  aiRepairExecutionRequests                 AiRepairExecutionRequest[]             @relation("repair_execution_request_actor")
  aiRepairExecutionAuditEvents              AiRepairExecutionAuditEvent[]          @relation("repair_execution_audit_event_actor")
  aiAgentRuns                               AiAgentRun[]                           @relation("agent_run_actor")
  projectResourceEditLeases                 ProjectResourceEditLease[]
  aiAgentSteps                              AiAgentStep[]                          @relation("agent_step_actor")
  aiAgentTimelineEvents                     AiAgentTimelineEvent[]                 @relation("agent_timeline_event_actor")
  aiPromptRegistryRevisions                 AiPromptRegistryRevision[]             @relation("prompt_registry_revision_actor")
  aiTaskRoutePolicyRevisions                AiTaskRoutePolicyRevision[]            @relation("task_route_policy_revision_actor")
  aiModelRegistryRevisions                  AiModelRegistryRevision[]              @relation("model_registry_revision_actor")
  aiProviderRegistryRevisions               AiProviderRegistryRevision[]           @relation("provider_registry_revision_actor")
  aiProviderHealthStates                    AiProviderHealthState[]                @relation("provider_health_state_actor")
  aiProviderHealthEvents                    AiProviderHealthEvent[]                @relation("provider_health_event_actor")
  aiContextMemories                         AiContextMemory[]                      @relation("context_memory_owner")
  editedAiContextMemories                   AiContextMemory[]                      @relation("context_memory_last_editor")
  aiContextMemoryContributions              AiContextMemoryContribution[]          @relation("context_memory_contributor")
  proposedProjectMemoryConflicts            AiProjectMemoryConflict[]              @relation("project_memory_conflict_proposer")
  resolvedProjectMemoryConflicts            AiProjectMemoryConflict[]              @relation("project_memory_conflict_resolver")
  updatedAiProjectMemorySettings            AiProjectMemorySettings[]              @relation("project_memory_settings_updater")
  aiContextMemoryEvents                     AiContextMemoryEvent[]                 @relation("context_memory_event_owner")
  aiContextPreferences                      AiContextPreference[]                  @relation("context_preference_user")
  createdAiContextProjects                  AiContextProject[]                     @relation("context_project_creator")
  aiContextProjectMemberships               AiContextProjectMember[]               @relation("context_project_member_user")
  updatedAiContextProjectPolicies           AiContextProject[]                     @relation("context_project_policy_updater")
  grantedAiContextProjectGrants             AiContextProjectGrant[]                @relation("context_project_grant_grantor")
  revokedAiContextProjectGrants             AiContextProjectGrant[]                @relation("context_project_grant_revoker")
  requestedAccessRequests                   AccessRequest[]                        @relation("access_request_requester")
  benefitedAccessRequests                   AccessRequest[]                        @relation("access_request_user_beneficiary")
  resolvedAccessRequests                    AccessRequest[]                        @relation("access_request_resolver")
  accessRequestAuditEvents                  AccessRequestAuditEvent[]              @relation("access_request_audit_actor")
  sentAiContextProjectInvitations           AiContextProjectInvitation[]           @relation("context_project_invitation_inviter")
  receivedAiContextProjectInvitations       AiContextProjectInvitation[]           @relation("context_project_invitation_invitee")
  aiContextProjectInvitationEvents          AiContextProjectInvitationAuditEvent[] @relation("context_project_invitation_audit_actor")
  aiContextProjectGrantEvents               AiContextProjectGrantAuditEvent[]      @relation("context_project_grant_audit_actor")
  aiContextProjectPolicyEvents              AiContextProjectPolicyAuditEvent[]     @relation("context_project_policy_audit_actor")
  initiatedAiContextProjectMembershipEvents AiContextProjectMembershipAuditEvent[] @relation("context_project_membership_audit_actor")
  subjectAiContextProjectMembershipEvents   AiContextProjectMembershipAuditEvent[] @relation("context_project_membership_audit_subject")
  createdAiContextProjectBlockers           AiContextProjectBlocker[]              @relation("context_project_blocker_creator")
  resolvedAiContextProjectBlockers          AiContextProjectBlocker[]              @relation("context_project_blocker_resolution_actor")
  aiContextRules                            AiContextRule[]                        @relation("context_rule_owner")
  createdAiContextRuleRevisions             AiContextRuleRevision[]                @relation("context_rule_revision_creator")
  createdAiContextPolicies                  AiContextPolicy[]                      @relation("context_policy_creator")
  createdAiContextPolicyRevisions           AiContextPolicyRevision[]              @relation("context_policy_revision_creator")
  aiProfileAssignment                       AiUserAiProfileAssignment?             @relation("ai_profile_assignment_user")
  createdOfficeArtifacts                    OfficeArtifact[]                       @relation("office_artifact_creator")
  createdOfficeRevisions                    OfficeRevision[]                       @relation("office_revision_creator")
  createdOfficeCommandRequests              OfficeCommandRequest[]                 @relation("office_command_request_creator")
  sentWorkOrders                            WorkOrder[]                            @relation("work_order_sender")
  receivedWorkOrders                        WorkOrder[]                            @relation("work_order_recipient")
  workOrderSessionBindings                  WorkOrderSessionBinding[]              @relation("work_order_session_owner")
  ownedAiSessionWorkStates                  AiSessionWorkState[]                   @relation("ai_session_work_state_owner")
  assignedAiSessionAttentions               AiSessionAttention[]                   @relation("ai_session_attention_actor")
  resolvedAiSessionAttentions               AiSessionAttention[]                   @relation("ai_session_attention_resolver")
  submittedWorkOrderDeliveries              WorkOrderDeliveryRevision[]            @relation("work_order_delivery_submitter")
  createdWorkOrderExchanges                 WorkOrderExchange[]                    @relation("work_order_exchange_actor")
  createdWorkOrderEvents                    WorkOrderEvent[]                       @relation("work_order_event_actor")
  adoptedWorkOrderDeliveries                WorkOrderAdoption[]                    @relation("work_order_adoption_actor")
  ownedWorkOrderBlobs                       WorkOrderBlob[]                        @relation("work_order_blob_owner")
  createdWorkOrderDispatches                WorkOrderDispatch[]                    @relation("work_order_dispatch_sender")

  @@index([email])
  @@map("users")
}

model ConnectedAccount {
  id                String    @id @default(uuid()) @db.VarChar
  userId            String    @map("user_id") @db.VarChar
  provider          String    @db.VarChar
  providerAccountId String    @map("provider_account_id") @db.VarChar
  scope             String?   @db.Text
  accessToken       String?   @map("access_token") @db.Text
  refreshToken      String?   @map("refresh_token") @db.Text
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerAccountId])
  @@map("user_connected_accounts")
}

model Session {
  id           String        @id @default(uuid()) @db.VarChar
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  userSessions UserSession[]

  @@map("multiple_users_sessions")
}

model UserSession {
  id                   String    @id @default(uuid()) @db.VarChar
  sessionId            String    @map("session_id") @db.VarChar
  userId               String    @map("user_id") @db.VarChar
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(3)
  signInClientVersion  String?   @map("sign_in_client_version") @db.VarChar
  refreshClientVersion String?   @map("refresh_client_version") @db.VarChar
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSession AuthSession?

  @@unique([sessionId, userId])
  @@map("user_sessions")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.VarChar
  userSessionId     String    @unique @map("user_session_id") @db.VarChar
  installationId    String    @map("installation_id") @db.VarChar
  platform          String    @db.VarChar
  deviceName        String?   @map("device_name") @db.VarChar
  appVersion        String?   @map("app_version") @db.VarChar
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason") @db.VarChar
  lastIpHash        String?   @map("last_ip_hash") @db.VarChar
  lastUserAgent     String?   @map("last_user_agent") @db.VarChar

  userSession   UserSession        @relation(fields: [userSessionId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([installationId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id            String    @id @db.VarChar
  authSessionId String    @map("auth_session_id") @db.VarChar
  generation    Int
  secretHash    String    @map("secret_hash") @db.VarChar
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById  String?   @unique @map("replaced_by_id") @db.VarChar
  graceUsedAt   DateTime? @map("grace_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  authSession AuthSession       @relation(fields: [authSessionId], references: [id], onDelete: Cascade)
  replacedBy  AuthRefreshToken? @relation("AuthRefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces    AuthRefreshToken? @relation("AuthRefreshRotation")

  @@unique([authSessionId, generation])
  @@index([authSessionId, usedAt])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}

model VerificationToken {
  token      String   @db.VarChar
  type       Int      @db.SmallInt
  credential String?  @db.Text
  expiresAt  DateTime @db.Timestamptz(3)

  @@unique([type, token])
  @@map("verification_tokens")
}

model MagicLinkOtp {
  id          String   @id @default(uuid()) @db.VarChar
  email       String   @unique @db.Text
  otpHash     String   @map("otp_hash") @db.VarChar
  token       String   @db.Text
  clientNonce String?  @map("client_nonce") @db.Text
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("magic_link_otps")
}

model Workspace {
  files WorkspaceFile[]

  officeComments OfficeComment[]

  // NOTE: manually set this column type to identity in migration file
  sid                 Int      @unique @default(autoincrement())
  id                  String   @id @default(uuid()) @db.VarChar
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // workspace level feature flags
  enableAi            Boolean  @default(true) @map("enable_ai")
  enableDocEmbedding  Boolean  @default(true) @map("enable_doc_embedding")
  name                String?  @db.VarChar
  avatarKey           String?  @map("avatar_key") @db.VarChar
  indexed             Boolean  @default(false)
  lastCheckEmbeddings DateTime @default("1970-01-01T00:00:00-00:00") @map("last_check_embeddings") @db.Timestamptz(3)

  features                              WorkspaceFeature[]
  docs                                  WorkspaceDoc[]
  blobs                                 Blob[]
  ignoredDocs                           AiWorkspaceIgnoredDocs[]
  embedFiles                            AiWorkspaceFiles[]
  byokConfigs                           AiWorkspaceByokConfig[]
  aiProfiles                            AiWorkspaceProfile[]                   @relation("ai_profile_workspace")
  aiProfileAssignments                  AiUserAiProfileAssignment[]            @relation("ai_profile_assignment_workspace")
  aiUsageEvents                         AiUsageEvent[]
  comments                              Comment[]
  commentAttachments                    CommentAttachment[]
  workspaceCalendars                    WorkspaceCalendar[]
  workspaceAdminStats                   WorkspaceAdminStats[]
  workspaceAdminStatsDirties            WorkspaceAdminStatsDirty[]
  workspaceAdminStatsDaily              WorkspaceAdminStatsDaily[]
  workspaceDocViewDaily                 WorkspaceDocViewDaily[]
  workspaceMemberLastAccess             WorkspaceMemberLastAccess[]
  quotaState                            EffectiveWorkspaceQuotaState?
  accessPolicy                          WorkspaceAccessPolicy?
  members                               WorkspaceMember[]
  invitations                           WorkspaceInvitation[]
  docAccessPolicies                     DocAccessPolicy[]
  docGrants                             DocGrant[]
  aiSupportBundleRequests               AiSupportBundleRequest[]               @relation("support_bundle_request_workspace")
  aiSupportBundleAuditEvents            AiSupportBundleAuditEvent[]            @relation("support_bundle_audit_event_workspace")
  aiSupportBundleDownloadAuthorizations AiSupportBundleDownloadAuthorization[] @relation("support_bundle_download_authorization_workspace")
  aiRepairExecutionRequests             AiRepairExecutionRequest[]             @relation("repair_execution_request_workspace")
  aiRepairExecutionAuditEvents          AiRepairExecutionAuditEvent[]          @relation("repair_execution_audit_event_workspace")
  aiAgentRuns                           AiAgentRun[]                           @relation("agent_run_workspace")
  aiAgentSteps                          AiAgentStep[]                          @relation("agent_step_workspace")
  aiAgentTimelineEvents                 AiAgentTimelineEvent[]                 @relation("agent_timeline_event_workspace")
  aiPromptRegistryRevisions             AiPromptRegistryRevision[]             @relation("prompt_registry_revision_workspace")
  aiTaskRoutePolicyRevisions            AiTaskRoutePolicyRevision[]            @relation("task_route_policy_revision_workspace")
  aiModelRegistryRevisions              AiModelRegistryRevision[]              @relation("model_registry_revision_workspace")
  aiProviderRegistryRevisions           AiProviderRegistryRevision[]           @relation("provider_registry_revision_workspace")
  aiProviderHealthStates                AiProviderHealthState[]                @relation("provider_health_state_workspace")
  aiProviderHealthEvents                AiProviderHealthEvent[]                @relation("provider_health_event_workspace")
  aiContextMemories                     AiContextMemory[]                      @relation("context_memory_workspace")
  aiContextMemoryEvents                 AiContextMemoryEvent[]                 @relation("context_memory_event_workspace")
  aiContextPreferences                  AiContextPreference[]                  @relation("context_preference_workspace")
  aiContextProjectGrants                AiContextProjectGrant[]                @relation("context_project_grant_workspace")
  accessRequests                        AccessRequest[]                        @relation("access_request_workspace")
  aiContextRules                        AiContextRule[]                        @relation("context_rule_workspace")
  aiContextPolicies                     AiContextPolicy[]                      @relation("context_policy_workspace")
  mcpResourceOperations                 McpResourceOperation[]
  docOutbox                             WorkspaceDocOutbox[]
  mcpCredentials                        McpCredential[]
  aiMcpAttachments                      AiMcpAttachment[]                      @relation("mcp_attachment_workspace")
  mcpDelegationEndpoints                AiMcpDelegationEndpoint[]              @relation("mcp_delegation_endpoint_workspace")
  aiMcpDelegationRequests               AiMcpDelegationRequest[]               @relation("mcp_delegation_request_workspace")
  externalMcpConnections                AiExternalMcpConnection[]              @relation("external_mcp_connection_workspace")
  externalMcpAuditEvents                AiExternalMcpAuditEvent[]              @relation("external_mcp_audit_workspace")
  externalMcpToolExecutions             AiExternalMcpToolExecution[]           @relation("external_mcp_tool_execution_workspace")
  enterpriseConnections                 AiEnterpriseConnection[]               @relation("enterprise_connection_workspace")
  enterpriseAuditEvents                 AiEnterpriseAuditEvent[]               @relation("enterprise_audit_workspace")
  enterpriseAuthorizationSessions       AiEnterpriseAuthorizationSession[]     @relation("enterprise_authorization_workspace")
  officeArtifacts                       OfficeArtifact[]                       @relation("office_artifact_workspace")
  officeRevisions                       OfficeRevision[]                       @relation("office_revision_workspace")
  officeCommandRequests                 OfficeCommandRequest[]                 @relation("office_command_request_workspace")
  directoryGrants                       WorkspaceDirectoryGrant[]

  @@index([lastCheckEmbeddings])
  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceDirectoryGrant {
  workspaceId     String   @map("workspace_id") @db.VarChar
  directoryId     String   @map("directory_id") @db.VarChar
  principalId     String   @map("principal_id") @db.VarChar
  canRead         Boolean  @map("can_read")
  canWrite        Boolean  @map("can_write")
  canOrganize     Boolean  @map("can_organize")
  canCreateFolder Boolean  @map("can_create_folder")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, directoryId, principalId])
  @@map("workspace_directory_grants")
}

model WorkspaceDirectoryPolicyEvent {
  id          String   @id @default(uuid()) @db.VarChar
  workspaceId String   @map("workspace_id") @db.VarChar
  actorId     String   @map("actor_id") @db.VarChar
  directoryId String   @map("directory_id") @db.VarChar
  principalId String   @map("principal_id") @db.VarChar
  action      String   @db.VarChar
  before      Json?    @map("before_policy") @db.JsonB
  after       Json?    @map("after_policy") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Intentionally retain actor/workspace identifiers as immutable evidence
  // even if their live records are later removed.
  @@index([workspaceId, createdAt, id])
  @@map("workspace_directory_policy_events")
}

model Entitlement {
  id            String    @id @default(uuid()) @db.VarChar
  targetType    String    @map("target_type") @db.Text
  targetId      String?   @map("target_id") @db.VarChar
  source        String    @db.Text
  plan          String    @db.Text
  status        String    @db.Text
  subjectId     String?   @map("subject_id") @db.VarChar
  issuer        String?   @db.Text
  quantity      Int?      @db.Integer
  signedPayload Bytes?    @map("signed_payload") @db.ByteA
  tokenHash     String?   @map("token_hash") @db.Text
  metadata      Json      @default("{}") @db.JsonB
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(3)
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(3)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  validatedAt   DateTime? @map("validated_at") @db.Timestamptz(3)
  graceUntil    DateTime? @map("grace_until") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userQuotaStates      EffectiveUserQuotaState[]
  workspaceQuotaStates EffectiveWorkspaceQuotaState[]

  @@index([targetType, targetId, status])
  @@index([status, expiresAt])
  @@map("entitlements")
}

model EffectiveUserQuotaState {
  userId               String    @id @map("user_id") @db.VarChar
  plan                 String    @db.Text
  sourceEntitlementId  String?   @map("source_entitlement_id") @db.VarChar
  blobLimit            BigInt    @map("blob_limit") @db.BigInt
  storageQuota         BigInt    @map("storage_quota") @db.BigInt
  usedStorageQuota     BigInt    @default(0) @map("used_storage_quota") @db.BigInt
  historyPeriodSeconds Int       @map("history_period_seconds") @db.Integer
  copilotActionLimit   Int?      @map("copilot_action_limit") @db.Integer
  flags                Json      @default("{}") @db.JsonB
  known                Boolean   @default(false)
  stale                Boolean   @default(false)
  lastReconciledAt     DateTime? @map("last_reconciled_at") @db.Timestamptz(3)
  staleAfter           DateTime? @map("stale_after") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntitlement Entitlement? @relation(fields: [sourceEntitlementId], references: [id], onDelete: SetNull)

  @@index([known, stale])
  @@index([staleAfter])
  @@map("effective_user_quota_states")
}

model EffectiveWorkspaceQuotaState {
  workspaceId             String    @id @map("workspace_id") @db.VarChar
  plan                    String    @db.Text
  sourceEntitlementId     String?   @map("source_entitlement_id") @db.VarChar
  ownerUserId             String?   @map("owner_user_id") @db.VarChar
  usesOwnerQuota          Boolean   @default(false) @map("uses_owner_quota")
  seatLimit               Int       @map("seat_limit") @db.Integer
  memberCount             Int       @default(0) @map("member_count") @db.Integer
  overcapacityMemberCount Int       @default(0) @map("overcapacity_member_count") @db.Integer
  blobLimit               BigInt    @map("blob_limit") @db.BigInt
  storageQuota            BigInt    @map("storage_quota") @db.BigInt
  usedStorageQuota        BigInt    @default(0) @map("used_storage_quota") @db.BigInt
  historyPeriodSeconds    Int       @map("history_period_seconds") @db.Integer
  readonly                Boolean   @default(false)
  readonlyReasons         String[]  @default([]) @map("readonly_reasons") @db.Text
  flags                   Json      @default("{}") @db.JsonB
  known                   Boolean   @default(false)
  stale                   Boolean   @default(false)
  lastReconciledAt        DateTime? @map("last_reconciled_at") @db.Timestamptz(3)
  staleAfter              DateTime? @map("stale_after") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
