// Direct MCP identities survive document deletion; the binding is a tombstone,
// never a cascading FK to mutable document content.
model McpResourceOperation {
  id                 String                        @id @default(uuid()) @db.VarChar
  contractVersion    String                        @map("contract_version") @db.VarChar(64)
  workspaceId        String                        @map("workspace_id") @db.VarChar
  actorId            String                        @map("actor_id") @db.VarChar
  credentialFamilyId String                        @map("credential_family_id") @db.VarChar
  credentialId       String                        @map("credential_id") @db.VarChar
  toolName           String                        @map("tool_name") @db.VarChar(64)
  idempotencyKey     String                        @map("idempotency_key") @db.VarChar(256)
  requestFingerprint String                        @map("request_fingerprint") @db.VarChar(64)
  documentId         String?                       @map("document_id") @db.VarChar
  folderId           String?                       @map("folder_id") @db.VarChar
  parentId           String?                       @map("parent_id") @db.VarChar
  status             String                        @default("processing") @db.VarChar(32)
  result             Json?
  errorCode          String?                       @map("error_code") @db.VarChar(64)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt        DateTime?                     @map("completed_at") @db.Timestamptz(3)
  workspace          Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor              User                          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  credential         McpCredential                 @relation(fields: [credentialId, credentialFamilyId, actorId, workspaceId], references: [id, familyId, userId, workspaceId], onDelete: NoAction)
  events             McpResourceOperationEvent[]
  externalDocuments  McpResourceExternalDocument[]

  @@unique([workspaceId, actorId, credentialFamilyId, toolName, idempotencyKey], map: "mcp_resource_operation_identity")
  @@unique([id, workspaceId, credentialFamilyId, documentId])
  @@index([workspaceId, actorId, credentialFamilyId, createdAt])
  @@map("mcp_resource_operations")
}

