  sessionId           String   @unique @map("session_id") @db.VarChar
  ownerUserId         String   @map("owner_user_id") @db.VarChar
  ownerUserIdSnapshot String   @map("owner_user_id_snapshot") @db.VarChar
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  owner     User      @relation("work_order_session_owner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("work_order_session_bindings")
}

model WorkOrderRequirement {
  id                String   @id @default(uuid()) @db.VarChar
  workOrderId       String   @map("work_order_id") @db.VarChar
  itemKey           String   @map("item_key") @db.VarChar(64)
  kind              String   @db.VarChar(16)
  title             String   @db.VarChar(256)
  instructions      String   @db.Text
  required          Boolean  @default(true)
  acceptedMimeTypes String[] @map("accepted_mime_types")
  minCount          Int      @default(1) @map("min_count")
  maxCount          Int      @default(1) @map("max_count")
  validationMode    String   @map("validation_mode") @db.VarChar(32)
  ordinal           Int
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder     WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  deliveryItems WorkOrderDeliveryItem[]
  draftBlobs    WorkOrderBlob[]

  @@unique([workOrderId, itemKey])
  @@unique([id, workOrderId])
  @@index([workOrderId, ordinal])
  @@map("work_order_requirements")
}

model WorkOrderExchange {
  id          String   @id @default(uuid()) @db.VarChar
  workOrderId String   @map("work_order_id") @db.VarChar
  actorId     String?  @map("actor_id") @db.VarChar
  kind        String   @db.VarChar(24)
  body        String   @db.Text
  fingerprint String   @db.VarChar(64)
  requestKey  String   @map("request_key") @db.VarChar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation("work_order_exchange_actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workOrderId, requestKey])
  @@index([workOrderId, createdAt])
  @@map("work_order_exchanges")
}

model WorkOrderBlob {
  id            String    @id @default(uuid()) @db.VarChar
  workOrderId   String    @map("work_order_id") @db.VarChar
  ownerId       String?   @map("owner_id") @db.VarChar
  requirementId String    @map("requirement_id") @db.VarChar
  requestKey    String    @map("request_key") @db.VarChar
  key           String    @db.VarChar(256)
  status        String    @default("staged") @db.VarChar(16)
  fileName      String    @map("file_name") @db.VarChar(512)
  mimeType      String    @map("mime_type") @db.VarChar(256)
  byteSize      Int       @map("byte_size")
  fingerprint   String    @db.VarChar(64)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder     WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  owner         User?                   @relation("work_order_blob_owner", fields: [ownerId], references: [id], onDelete: SetNull)
  requirement   WorkOrderRequirement    @relation(fields: [requirementId, workOrderId], references: [id, workOrderId], onDelete: Restrict, onUpdate: Restrict)
  deliveryItems WorkOrderDeliveryItem[]

  @@unique([workOrderId, key])
  @@unique([workOrderId, requestKey])
  @@unique([id, workOrderId])
  @@index([status, expiresAt])
  @@map("work_order_blobs")
}

model WorkOrderDeliveryRevision {
  id                      String   @id @default(uuid()) @db.VarChar
  workOrderId             String   @map("work_order_id") @db.VarChar
  revision                Int
  submittedBy             String?  @map("submitted_by") @db.VarChar
  requirementsFingerprint String   @map("requirements_fingerprint") @db.VarChar(64)
  receiptFingerprint      String   @map("receipt_fingerprint") @db.VarChar(64)
  validationEvidence      Json     @map("validation_evidence") @db.JsonB
  status                  String   @default("complete") @db.VarChar(16)
  submittedAt             DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  workOrder WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  submitter User?                   @relation("work_order_delivery_submitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  items     WorkOrderDeliveryItem[]
  adoptions WorkOrderAdoptionItem[]

  @@unique([workOrderId, revision])
  @@unique([id, workOrderId])
  @@index([workOrderId, submittedAt(sort: Desc)])
  @@map("work_order_delivery_revisions")
}

model WorkOrderDeliveryItem {
  id                 String   @id @default(uuid()) @db.VarChar
  deliveryRevisionId String   @map("delivery_revision_id") @db.VarChar
  workOrderId        String   @map("work_order_id") @db.VarChar
  requirementId      String   @map("requirement_id") @db.VarChar
  blobId             String?  @map("blob_id") @db.VarChar
  textValue          String?  @map("text_value") @db.Text
  evidence           Json     @default("{}") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveryRevision WorkOrderDeliveryRevision @relation(fields: [deliveryRevisionId, workOrderId], references: [id, workOrderId], onDelete: Cascade, onUpdate: Restrict)
  requirement      WorkOrderRequirement      @relation(fields: [requirementId, workOrderId], references: [id, workOrderId], onDelete: Restrict, onUpdate: Restrict)
  blob             WorkOrderBlob?            @relation(fields: [blobId, workOrderId], references: [id, workOrderId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deliveryRevisionId, requirementId, blobId])
  @@index([workOrderId, requirementId])
  @@map("work_order_delivery_items")
}

model WorkOrderEvent {
  id               String   @id @default(uuid()) @db.VarChar
  workOrderId      String   @map("work_order_id") @db.VarChar
  actorId          String?  @map("actor_id") @db.VarChar
  eventType        String   @map("event_type") @db.VarChar(48)
  version          Int
  payload          Json     @default("{}") @db.JsonB
  eventFingerprint String   @unique @map("event_fingerprint") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor     User?     @relation("work_order_event_actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([workOrderId, version])
  @@index([workOrderId, createdAt])
  @@map("work_order_events")
}

model WorkOrderOutbox {
  id          BigInt    @id @default(autoincrement())
  workOrderId String    @map("work_order_id") @db.VarChar
  eventId     String    @map("event_id") @db.VarChar
  recipientId String    @map("recipient_id") @db.VarChar
  channel     String    @default("in_app") @db.VarChar(24)
  topic       String    @db.VarChar(64)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@unique([eventId, recipientId, channel])
  @@index([deliveredAt, availableAt])
  @@map("work_order_outbox")
}

model WorkOrderAdoption {
  id                      String   @id @default(uuid()) @db.VarChar
  sourceSessionId         String?  @map("source_session_id") @db.VarChar
  sourceSessionIdSnapshot String   @map("source_session_id_snapshot") @db.VarChar
  actorId                 String?  @map("actor_id") @db.VarChar
  contextVersion          Int      @map("context_version")
  requestKey              String   @map("request_key") @db.VarChar
  revisionSetFingerprint  String   @map("revision_set_fingerprint") @db.VarChar(64)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceSession AiSession?              @relation("work_order_adoption_source_session", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  actor         User?                   @relation("work_order_adoption_actor", fields: [actorId], references: [id], onDelete: SetNull)
  items         WorkOrderAdoptionItem[]

  @@unique([sourceSessionIdSnapshot, requestKey])
  @@unique([sourceSessionIdSnapshot, contextVersion])
  @@map("work_order_adoptions")
}

model WorkOrderAdoptionItem {
  adoptionId         String @map("adoption_id") @db.VarChar
  workOrderId        String @map("work_order_id") @db.VarChar
  deliveryRevisionId String @map("delivery_revision_id") @db.VarChar

  adoption       WorkOrder                 @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  adoptionRecord WorkOrderAdoption         @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  delivery       WorkOrderDeliveryRevision @relation(fields: [deliveryRevisionId, workOrderId], references: [id, workOrderId], onDelete: Restrict, onUpdate: Restrict)

  @@id([adoptionId, workOrderId])
  @@map("work_order_adoption_items")
}

model AiSessionDeletion {
  id                   String    @id @default(uuid()) @db.VarChar
  sessionId            String    @unique @map("session_id") @db.VarChar
  ownerUserIdSnapshot  String    @map("owner_user_id_snapshot") @db.VarChar
  workspaceIdSnapshot  String?   @map("workspace_id_snapshot") @db.VarChar
  projectIdSnapshot    String?   @map("project_id_snapshot") @db.VarChar
  contextEpoch         Int       @map("context_epoch")
  status               String    @default("requested") @db.VarChar
  requestFingerprint   String    @map("request_fingerprint") @db.VarChar
  progress             Json      @default("{}") @db.JsonB
  resultCounts         Json      @default("{}") @map("result_counts") @db.JsonB
  attempt              Int       @default(0)
  maxAttempts          Int       @default(5) @map("max_attempts")
  workerLeaseId        String?   @map("worker_lease_id") @db.VarChar
  workerLeaseExpiresAt DateTime? @map("worker_lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt        DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  failureCode          String?   @map("failure_code") @db.VarChar
  failureMessage       String?   @map("failure_message") @db.Text
  holdReason           String?   @map("hold_reason") @db.VarChar
  heldAt               DateTime? @map("held_at") @db.Timestamptz(3)
  releasedAt           DateTime? @map("released_at") @db.Timestamptz(3)
  receiptFingerprint   String?   @map("receipt_fingerprint") @db.VarChar
  retentionClass       String    @default("long_term_minimal") @map("retention_class") @db.VarChar
  requestedAt          DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)

  session AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([workerLeaseExpiresAt])
  @@index([ownerUserIdSnapshot, requestedAt])
  @@map("ai_session_deletions")
}

model AiSessionProjectBlobReference {
  sessionId String   @map("session_id") @db.VarChar
  projectId String   @map("project_id") @db.VarChar
  blobKey   String   @map("blob_key") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session AiSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  blob    ProjectBlob @relation(fields: [projectId, blobKey], references: [projectId, key], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionId, projectId, blobKey])
  @@index([projectId, blobKey])
  @@map("ai_session_project_blob_references")
}

model CopilotDocumentOperation {
  id                     String    @id @default(uuid()) @db.VarChar
  kind                   String    @default("create") @db.VarChar
  sessionId              String    @map("session_id") @db.VarChar
  actorId                String    @map("actor_id") @db.VarChar
  projectId              String?   @map("project_id") @db.VarChar
  requestKey             String    @map("request_key") @db.VarChar
  contentFingerprint     String    @map("content_fingerprint") @db.VarChar
  title                  String    @db.VarChar
  markdown               String    @db.Text
  documentId             String    @unique @default(uuid()) @map("document_id") @db.VarChar
  destinationWorkspaceId String?   @map("destination_workspace_id") @db.VarChar
  destinationFolderId    String?   @map("destination_folder_id") @db.VarChar
  destinationRevision    Int       @default(0) @map("destination_revision")
  destinationConfirmedAt DateTime? @map("destination_confirmed_at") @db.Timestamptz(3)
  destinationFingerprint String?   @map("destination_fingerprint") @db.VarChar
  destinationConfirmedBy String?   @map("destination_confirmed_by") @db.VarChar
  destinationEvidence    Json      @default("{}") @map("destination_evidence") @db.JsonB
  locationExpiresAt      DateTime  @default(dbgenerated("(now() + '24:00:00'::interval)")) @map("location_expires_at") @db.Timestamptz(3)
  status                 String    @default("waiting_location") @db.VarChar
  createdDocumentAt      DateTime? @map("created_document_at") @db.Timestamptz(3)
  placedDocumentAt       DateTime? @map("placed_document_at") @db.Timestamptz(3)
  executionStartedAt     DateTime? @map("execution_started_at") @db.Timestamptz(3)
  projectStatus          String    @default("not_requested") @map("project_status") @db.VarChar
  accessRequestId        String?   @map("access_request_id") @db.VarChar
  leaseToken             String?   @map("lease_token") @db.VarChar
  leaseExpiresAt         DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  failureCode            String?   @map("failure_code") @db.VarChar
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  events            CopilotDocumentOperationEvent[]
  copySource        CopilotDocumentCopySource?
  waitingDelegation AiMcpDelegationRequest?         @relation("mcp_delegation_location_operation")

  @@unique([sessionId, requestKey])
  @@index([status, leaseExpiresAt])
  @@map("copilot_document_operations")
}

model CopilotDocumentCopySource {
  operationId String                     @id @map("operation_id") @db.VarChar
  workspaceId String                     @map("workspace_id") @db.VarChar
  documentId  String                     @map("document_id") @db.VarChar
  snapshot    Bytes                      @db.ByteA
  fingerprint String                     @db.VarChar
  operation   CopilotDocumentOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  assets      CopilotDocumentCopyAsset[]

  @@map("copilot_document_copy_sources")
}

model CopilotDocumentCopyAsset {
  operationId String                    @map("operation_id") @db.VarChar
  key         String                    @db.VarChar
  data        Bytes                     @db.ByteA
  contentType String                    @map("content_type") @db.VarChar
  fingerprint String                    @db.VarChar
  source      CopilotDocumentCopySource @relation(fields: [operationId], references: [operationId], onDelete: Cascade)

  @@id([operationId, key])
  @@map("copilot_document_copy_assets")
}

model CopilotDocumentOperationEvent {
  id          String   @id @default(uuid()) @db.VarChar
  operationId String   @map("operation_id") @db.VarChar
  eventType   String   @map("event_type") @db.VarChar
  detail      Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operation CopilotDocumentOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
  @@map("copilot_document_operation_events")
}

model AiContextMemory {
  // Migrations additionally enforce scope/lifecycle/content CHECK constraints
  // and expression-based partial uniqueness that Prisma cannot represent.
  id                          String                       @id @default(uuid()) @db.VarChar
  ownerUserId                 String?                      @map("owner_user_id") @db.VarChar
  lastEditedByUserId          String?                      @map("last_edited_by_user_id") @db.VarChar
  workspaceId                 String?                      @map("workspace_id") @db.VarChar
  docId                       String?                      @map("doc_id") @db.VarChar
  projectId                   String?                      @map("project_id") @db.VarChar
  sourceSessionId             String?                      @map("source_session_id") @db.VarChar
  scope                       String                       @db.VarChar
  kind                        String                       @db.VarChar
  visibility                  String                       @default("private") @db.VarChar
  status                      String                       @default("active") @db.VarChar
  content                     String                       @db.Text
  fingerprint                 String                       @db.VarChar
  factKey                     String?                      @map("fact_key") @db.VarChar
  confidence                  Float                        @default(1)
  importance                  Float                        @default(0.5)
  sensitivity                 String                       @default("private") @db.VarChar
  captureMode                 String                       @default("manual") @map("capture_mode") @db.VarChar
  writerVersion               String                       @default("legacy/v1") @map("writer_version") @db.VarChar
  validFrom                   DateTime?                    @map("valid_from") @db.Timestamptz(3)
  validUntil                  DateTime?                    @map("valid_until") @db.Timestamptz(3)
  expiresAt                   DateTime?                    @map("expires_at") @db.Timestamptz(3)
  supersedesId                String?                      @map("supersedes_id") @db.VarChar
  lastUsedAt                  DateTime?                    @map("last_used_at") @db.Timestamptz(3)
  useCount                    Int                          @default(0) @map("use_count")
  revision                    Int                          @default(1)
  sharingStatus               String                       @default("private") @map("sharing_status") @db.VarChar
  contractVersion             String                       @default("legacy/v1") @map("contract_version") @db.VarChar
  quarantinedAt               DateTime?                    @map("quarantined_at") @db.Timestamptz(3)
  quarantineReason            String?                      @map("quarantine_reason") @db.VarChar
  quarantinedByProjectGrantId String?                      @map("quarantined_by_project_grant_id") @db.VarChar
  projectSourceCheckId        String?                      @map("project_source_check_id") @db.VarChar
  embedding                   Unsupported("vector(4096)")?
  metadata                    Json                         @default("{}") @db.JsonB
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                     User?                         @relation("context_memory_owner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lastEditor                User?                         @relation("context_memory_last_editor", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  workspace                 Workspace?                    @relation("context_memory_workspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  project                   AiContextProject?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceSession             AiSession?                    @relation("context_memory_source_session", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  supersedes                AiContextMemory?              @relation("context_memory_supersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy              AiContextMemory[]             @relation("context_memory_supersession")
  events                    AiContextMemoryEvent[]        @relation("context_memory_event_memory")
  previousEvents            AiContextMemoryEvent[]        @relation("context_memory_event_previous_memory")
  sources                   AiContextMemorySource[]
  summaryRevisions          ProjectSummaryRevision[]
  contributions             AiContextMemoryContribution[]
  conflicts                 AiProjectMemoryConflict[]
  projectSourceCheck        AiSharedWriteSourceCheck?     @relation(fields: [projectSourceCheckId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quarantinedByProjectGrant AiContextProjectGrant?        @relation("context_memory_quarantine_grant", fields: [quarantinedByProjectGrantId], references: [id], onDelete: SetNull)

  @@unique([id, projectId])
  @@index([ownerUserId, status, updatedAt])
  @@index([lastEditedByUserId, updatedAt])
  @@index([workspaceId, docId, status, updatedAt])
  @@index([projectId, status, updatedAt])
  @@index([ownerUserId, factKey, status, updatedAt])
  @@index([expiresAt, status])
  @@index([lastUsedAt])
  @@index([supersedesId])
  @@index([sourceSessionId])
  @@index([projectSourceCheckId])
  @@index([quarantinedByProjectGrantId, status])
  @@index([fingerprint])
  @@map("ai_context_memories")
}

model AiContextMemoryContribution {
  id                 String    @id @default(uuid()) @db.VarChar
  memoryId           String    @map("memory_id") @db.VarChar
  projectId          String    @map("project_id") @db.VarChar
  contributorUserId  String?   @map("contributor_user_id") @db.VarChar
  sourceSessionId    String?   @map("source_session_id") @db.VarChar
  sourceTurnId       String?   @map("source_turn_id") @db.VarChar
  contributionKind   String    @default("create") @map("contribution_kind") @db.VarChar
  status             String    @default("active") @db.VarChar
  contentFingerprint String    @map("content_fingerprint") @db.VarChar
  requestFingerprint String    @unique @map("request_fingerprint") @db.VarChar
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  withdrawnAt        DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  memory      AiContextMemory  @relation(fields: [memoryId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Restrict)
  project     AiContextProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contributor User?            @relation("context_memory_contributor", fields: [contributorUserId], references: [id], onDelete: SetNull)
  source      AiSession?       @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  @@index([memoryId, status, createdAt])
  @@index([projectId, contributorUserId, status, createdAt])
  @@index([sourceSessionId, createdAt])
  @@map("ai_context_memory_contributions")
}

model AiProjectMemoryConflict {
  id                     String    @id @default(uuid()) @db.VarChar
  projectId              String    @map("project_id") @db.VarChar
  baseMemoryId           String    @map("base_memory_id") @db.VarChar
  proposedByUserId       String?   @map("proposed_by_user_id") @db.VarChar
  sourceSessionId        String?   @map("source_session_id") @db.VarChar
  sourceTurnId           String?   @map("source_turn_id") @db.VarChar
  factKey                String    @map("fact_key") @db.VarChar
  proposedContent        String    @map("proposed_content") @db.Text
  proposedFingerprint    String    @map("proposed_fingerprint") @db.VarChar
  status                 String    @default("pending") @db.VarChar
  expectedMemoryRevision Int       @map("expected_memory_revision")
  requestFingerprint     String    @unique @map("request_fingerprint") @db.VarChar
  resolvedByUserId       String?   @map("resolved_by_user_id") @db.VarChar
  resolution             String?   @db.VarChar
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt             DateTime? @map("resolved_at") @db.Timestamptz(3)

  project  AiContextProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  memory   AiContextMemory  @relation(fields: [baseMemoryId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Restrict)
  source   AiSession?       @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  proposer User?            @relation("project_memory_conflict_proposer", fields: [proposedByUserId], references: [id], onDelete: SetNull)
  resolver User?            @relation("project_memory_conflict_resolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([baseMemoryId, status])
  @@map("ai_project_memory_conflicts")
}

model AiContextMemoryEvent {
  id                  String    @id @default(uuid()) @db.VarChar
  ownerUserId         String?   @map("owner_user_id") @db.VarChar
  workspaceId         String?   @map("workspace_id") @db.VarChar
  projectId           String?   @map("project_id") @db.VarChar
  sourceSessionId     String?   @map("source_session_id") @db.VarChar
  sourceTurnId        String?   @map("source_turn_id") @db.VarChar
  operation           String    @db.VarChar
