  operationSummary       Json                 @default("{}") @map("operation_summary") @db.JsonB
  createdBy              String               @map("created_by") @db.VarChar
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace          Workspace?             @relation("office_revision_workspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  project            AiContextProject?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  artifact           OfficeArtifact         @relation("office_artifact_revisions", fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creator            User                   @relation("office_revision_creator", fields: [createdBy], references: [id], onDelete: Restrict)
  parent             OfficeRevision?        @relation("office_revision_parent", fields: [parentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children           OfficeRevision[]       @relation("office_revision_parent")
  commandRequests    OfficeCommandRequest[] @relation("office_command_request_expected_revision")
  packageBlob        Blob?                  @relation("office_revision_package_blob", fields: [workspaceId, packageBlobKey], references: [workspaceId, key], onDelete: Restrict, onUpdate: Restrict)
  packageProjectBlob ProjectBlob?           @relation("office_project_package_blob", fields: [projectId, packageBlobKey], references: [projectId, key], onDelete: Restrict, onUpdate: Restrict)
  stateProjectBlob   ProjectBlob?           @relation("office_project_state_blob", fields: [projectId, stateBlobKey], references: [projectId, key], onDelete: Restrict, onUpdate: Restrict)
  stateBlob          Blob?                  @relation("office_revision_state_blob", fields: [workspaceId, stateBlobKey], references: [workspaceId, key], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, artifactId, workspaceId])
  @@unique([id, artifactId, projectId])
  @@unique([artifactId, sequence])
  @@unique([artifactId, idempotencyKey])
  @@index([projectId, artifactId, createdAt(sort: Desc)])
  @@index([workspaceId, artifactId, createdAt(sort: Desc)])
  @@map("office_revisions")
}

